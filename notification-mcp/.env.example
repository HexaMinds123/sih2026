# Escalation & Notification MCP Server Environment Configuration
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT (NEVER COMMIT .env TO SOURCE CONTROL)

# SQLite audit database location (defaults to audit.db in this directory)
NOTIFICATION_DB_PATH=audit.db

# Single-use confirmation token expiry in seconds (default: 300 seconds / 5 minutes)
TOKEN_EXPIRY_SECONDS=300

# SMS Provider Toggle:
# Set to 'false' to use the offline MockSMSSender (safe for tests & hackathons)
# Set to 'true' to deliver actual SMS via Twilio
ENABLE_TWILIO=false

# Twilio Credentials (required only when ENABLE_TWILIO=true)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+15005550006
