  },
  {
    "id": "dailymed-lisinopril-34bb4602-indication",
    "medication": "lisinopril",
    "condition": "hypertension",
    "topic": "indication and dosage",
    "text": "The DailyMed lisinopril tablets label states that the product is indicated for treatment of hypertension in adults and pediatric patients 6 years of age and older; it lists a recommended adult initial dose of 10 mg once a day.",
    "source": "DailyMed",
    "document_id": "34bb4602-ccff-4939-91b9-26a63bfd40f7",
    "version": 24,
    "jurisdiction": "United States",
    "publication_date": "2026-08-04",
