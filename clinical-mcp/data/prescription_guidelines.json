  },
  {
    "id": "dailymed-warfarin-5a5b5e3a-monitoring",
    "medication": "warfarin",
    "condition": null,
    "topic": "monitoring and warning",
    "text": "The DailyMed warfarin sodium label states that warfarin can cause major or fatal bleeding and directs regular monitoring of INR in treated patients.",
    "source": "DailyMed",
    "document_id": "5a5b5e3a-6556-a542-e063-6294a90a6d3f",
