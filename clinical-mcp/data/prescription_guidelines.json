  },
  {
    "id": "dailymed-warfarin-5a5b5e3a-indication",
    "medication": "warfarin",
    "condition": null,
    "topic": "indication",
    "text": "The DailyMed warfarin sodium label lists prophylaxis and treatment of venous thrombosis and its extension, pulmonary embolism, and thromboembolic complications associated with atrial fibrillation and cardiac valve replacement.",
    "source": "DailyMed",
    "document_id": "5a5b5e3a-6556-a542-e063-6294a90a6d3f",
