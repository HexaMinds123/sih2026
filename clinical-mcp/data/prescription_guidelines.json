  },
  {
    "id": "dailymed-ibuprofen-40071818-warning",
    "medication": "ibuprofen",
    "condition": null,
    "topic": "warning",
    "text": "The DailyMed ibuprofen tablets label warns of increased risk of serious cardiovascular thrombotic events and serious gastrointestinal adverse events including bleeding, ulceration, and perforation.",
    "source": "DailyMed",
    "document_id": "40071818-5bf0-095b-e063-6294a90ad58a",
    "version": 4,
    "jurisdiction": "United States",
    "publication_date": "2026-09-04",
    "section": "BOXED WARNING",
    "page": null,
    "source_url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=40071818-5bf0-095b-e063-6294a90ad58a"
  },
  {
    "id": "dailymed-ibuprofen-40071818-dosage",
    "medication": "ibuprofen",
    "condition": null,
    "topic": "dosage reference",
    "text": "The DailyMed ibuprofen tablets label instructs that potential benefits and risks should be considered and that the lowest effective dose should be used for the shortest duration consistent with treatment goals.",
    "source": "DailyMed",
    "document_id": "40071818-5bf0-095b-e063-6294a90ad58a",
    "version": 4,
