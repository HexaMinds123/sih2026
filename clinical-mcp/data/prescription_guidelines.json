[
  {
    "id": "dailymed-metformin-5e783025-indication",
    "medication": "metformin",
    "condition": "type 2 diabetes",
    "topic": "indication",
    "text": "The DailyMed metformin hydrochloride tablets label states that the product is indicated as an adjunct to diet and exercise to improve glycemic control in adults and pediatric patients 10 years of age and older with type 2 diabetes mellitus.",
    "source": "DailyMed",
    "document_id": "5e783025-bf6d-465e-bf58-bcd253afad2c",
    "version": 6,
    "jurisdiction": "United States",
    "publication_date": "2026-06-24",
    "section": "1 INDICATIONS AND USAGE",
    "page": null,
    "source_url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=5e783025-bf6d-465e-bf58-bcd253afad2c"
  },
  {
    "id": "dailymed-metformin-5e783025-dosage",
    "medication": "metformin",
    "condition": "type 2 diabetes",
    "topic": "dosage reference",
    "text": "The DailyMed metformin hydrochloride tablets label lists a recommended adult starting dose of 500 mg orally twice a day or 850 mg once a day, given with meals.",
    "source": "DailyMed",
    "document_id": "5e783025-bf6d-465e-bf58-bcd253afad2c",
    "version": 6,
    "jurisdiction": "United States",
    "publication_date": "2026-06-24",
    "section": "2 DOSAGE AND ADMINISTRATION",
    "page": null,
    "source_url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=5e783025-bf6d-465e-bf58-bcd253afad2c"
  },
  {
    "id": "dailymed-metformin-5e783025-precaution",
    "medication": "metformin",
    "condition": null,
    "topic": "contraindication and precaution",
    "text": "The DailyMed metformin hydrochloride tablets label states that severe renal impairment, defined in the label as eGFR below 30 mL/min/1.73 m2, is a contraindication and describes lactic acidosis as a boxed warning.",
    "source": "DailyMed",
    "document_id": "5e783025-bf6d-465e-bf58-bcd253afad2c",
    "version": 6,
    "jurisdiction": "United States",
    "publication_date": "2026-06-24",
    "section": "BOXED WARNING; 4 CONTRAINDICATIONS",
    "page": null,
    "source_url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=5e783025-bf6d-465e-bf58-bcd253afad2c"
  },
  {
    "id": "dailymed-amlodipine-edf9b22c-indication",
    "medication": "amlodipine",
    "condition": "hypertension",
    "topic": "indication",
    "text": "The DailyMed amlodipine besylate tablets label states that the product is indicated for treatment of hypertension and lowering blood pressure.",
    "source": "DailyMed",
    "document_id": "edf9b22c-e37e-4b4e-8a64-20bb036c7d2d",
    "version": 7,
    "jurisdiction": "United States",
