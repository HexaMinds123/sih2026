  },
  {
    "id": "dailymed-amlodipine-edf9b22c-dosage",
    "medication": "amlodipine",
    "condition": "hypertension",
    "topic": "dosage reference",
    "text": "The DailyMed amlodipine besylate tablets label states that the usual initial adult antihypertensive oral dose is 5 mg once daily and the maximum dose is 10 mg once daily.",
    "source": "DailyMed",
    "document_id": "edf9b22c-e37e-4b4e-8a64-20bb036c7d2d",
    "version": 7,
    "jurisdiction": "United States",
