    "page": null,
    "source_url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=edf9b22c-e37e-4b4e-8a64-20bb036c7d2d"
  },
  {
    "id": "dailymed-amlodipine-edf9b22c-precaution",
    "medication": "amlodipine",
    "condition": null,
    "topic": "precaution",
    "text": "The DailyMed amlodipine besylate tablets label describes possible symptomatic hypotension, particularly in patients with severe aortic stenosis.",
