    "page": null,
    "source_url": "https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=34bb4602-ccff-4939-91b9-26a63bfd40f7"
  },
  {
    "id": "dailymed-lisinopril-34bb4602-precaution",
    "medication": "lisinopril",
    "condition": null,
    "topic": "boxed warning",
    "text": "The DailyMed lisinopril tablets label carries a fetal toxicity warning and states that lisinopril can cause fetal harm when administered during pregnancy.",
    "source": "DailyMed",
    "document_id": "34bb4602-ccff-4939-91b9-26a63bfd40f7",
    "version": 24,
    "jurisdiction": "United States",
